FROM ghcr.io/aaif-goose/goose:latest

USER root

# Install Python and dependencies for airlock + broker tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends python3 python3-pip python3-venv && \
    rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --no-cache-dir --break-system-packages \
    fastmcp \
    fastapi \
    uvicorn

COPY broker_tools.py /app/broker_tools.py
COPY airlock.py /app/airlock.py
COPY triage-recipe.yaml /app/triage-recipe.yaml
COPY entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && chmod 644 /app/*.py /app/*.yaml

# OpenShift SCC compatibility
RUN chgrp -R 0 /app && chmod -R g=u /app && \
    mkdir -p /home/goose/.config/goose && \
    chgrp -R 0 /home/goose && chmod -R g=u /home/goose

USER 1000
ENV HOME=/home/goose
EXPOSE 3284 8082

ENTRYPOINT ["bash", "/app/entrypoint.sh"]
